# ---------------------------------------------------------------------------
# dsh-plugin-lightnovel — 飞牛 NAS / Docker Compose configuration
# Copy to .env:  cp .env.example .env
# ---------------------------------------------------------------------------

# >>> 改成飞牛 NAS 上共享文件夹的实际绝对路径 <<<
# 容器内固定挂载到 /data；EPUB 库、任务状态、日志、索引都写在这里。
LN_DATA_DIR=./data

# 运行容器使用的 uid:gid（改成共享文件夹所有者，飞牛通常为 1000）
LN_UID=1000
LN_GID=1000

# ----- 书源 -----
# 可选书源：bilinovel、wenku8、fixture
# wenku8 默认禁用（部分页面可能要求登录），且插件永不提供凭据。
LN_ENABLED_SOURCES=bilinovel,fixture
# 完全离线（仅 fixture 书源，适合无外网 / CI）：true
LN_OFFLINE_ONLY=false
# 遵守 robots.txt 与每主机限速：true
LN_RESPECT_ROBOTS=true
# 同一主机两次请求的最小间隔（毫秒），请保持礼貌
LN_REQUEST_INTERVAL_MS=4000

# ----- 下载任务 -----
LN_MAX_CONCURRENT_DOWNLOADS=1
LN_MAX_RETRIES=2
LN_LOG_LEVEL=info

# ----- Web UI（可选，使用 command: ["--profile","nas","web"] 时生效）-----
LN_WEB_PORT=3080

# ----- 构建期 -----
# 中国大陆建议保留镜像；其他地区可改为 https://pub.dev
PUB_HOSTED_URL=https://pub.flutter-io.cn
# 双栈主机若 Dart SDK（约 228MB）下载极慢，可强制走较快的 IP 族：
# 先分别测 curl --noproxy '*' -4 / -6 的下载速度，再按需设置为 -6 或 -4。
# 留空则由 curl 自行选择。
# DART_CURL_OPTS=-6
# 若构建容器内单连接仍很慢：宿主机下载 SDK 到 build-assets/ 目录后会自动
# 跳过容器内下载（见 docs/DEPLOY-NAS.md）。

# ----- 运行 DSH Agent 时按需提供（仅 --dump-config 验证不需要）-----
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
