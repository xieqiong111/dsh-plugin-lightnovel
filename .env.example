# ---------------------------------------------------------------------------
# dsh-plugin-lightnovel — 飞牛 NAS / Docker Compose configuration
# Copy to .env:  cp .env.example .env
# ---------------------------------------------------------------------------

# >>> 改成飞牛 NAS 上共享文件夹的实际绝对路径 <<<
# 容器内固定挂载到 /data；EPUB 库、任务状态、日志、索引都写在这里。
LN_DATA_DIR=./data

# 运行容器使用的 uid:gid（改成共享文件夹所有者，飞牛通常为 1000）
LN_UID=1000
LN_GID=1000

# ----- 书源 -----
# 可选书源：bilinovel、wenku8、fixture
# wenku8 默认禁用（部分页面可能要求登录），且插件永不提供凭据。
LN_ENABLED_SOURCES=bilinovel,fixture
# 完全离线（仅 fixture 书源，适合无外网 / CI）：true
LN_OFFLINE_ONLY=false
# 遵守 robots.txt 与每主机限速：true
LN_RESPECT_ROBOTS=true
# 同一主机两次请求的最小间隔（毫秒），请保持礼貌
LN_REQUEST_INTERVAL_MS=4000

# ----- 下载任务 -----
LN_MAX_CONCURRENT_DOWNLOADS=1
LN_MAX_RETRIES=2
LN_LOG_LEVEL=info

# ----- Web UI（可选，使用 command: ["--profile","nas","web"] 时生效）-----
LN_WEB_PORT=3080

# ----- Novel & Manga Studio（docker-compose.web.yml）-----
LN_STUDIO_PORT=5273
# Studio 单独使用小说任务与书库目录。升级已部署的独立 Studio 时保留原目录。
LN_STUDIO_DATA_DIR=./data/studio
# LN_WEB_IMAGE=node:24-bookworm-slim
# LN_WEB_NETWORK=dsh-lightnovel-net
# LN_WEB_CONTAINER_NAME=lightnovel-studio-web
# 可选 API token（对局域网开放时建议设置；不要提交真实值）
# LN_BFF_TOKEN=
# Docker Studio 默认要求首次创建管理员。直接启动 Node 时可显式设为 true。
# LN_STUDIO_ACCOUNTS=true
# 留空时自动生成初始化码，保存在 Studio 数据目录的 auth/setup-code。
# LN_STUDIO_SETUP_CODE=
# HTTPS 入口启用 Secure Cookie。反代如果改写 Host，请填写浏览器看到的完整 origin。
# LN_STUDIO_SECURE_COOKIE=true
# LN_STUDIO_WEB_ORIGIN=https://studio.example.com
# 是否允许删除书库文件（默认 false）
# LN_BFF_ALLOW_DELETE=false

# WebUI 保存目录选择范围。提前建立并给 LN_UID/LN_GID 写权限。
# LN_NOVEL_STORAGE_HOST=./data/novel-downloads
# LN_MANGA_STORAGE_HOST=./data/manga-downloads
# 两份 Compose 使用同一个绝对路径；漫画归档服务只读挂载此目录。
# LN_DOWNLOAD_SETTINGS_HOST=/path/to/shared/download-settings
# 启用漫画归档时，SUWAYOMI_VOLUME_OUTPUT_DIR 应与 LN_MANGA_STORAGE_HOST 相同。

# ----- Suwayomi（可选）-----
# 连接现有实例时填写容器可达的 origin。启动 compose 的 manga profile 时用这一项：
# SUWAYOMI_URL=http://suwayomi:4567
# BFF/DSH 支持上游无认证或 HTTP Basic。Basic 使用成对的账号与密码。
# SUWAYOMI_USERNAME=
# SUWAYOMI_PASSWORD=
# SUWAYOMI_TIMEOUT_MS=8000
# SUWAYOMI_TITLE_ALIASES='[["星港邮差","星際信使"]]'
# 内置 Suwayomi 服务的管理端口默认绑定回环地址。
# 启用上游 Basic 时，同时设置 Studio 的 LN_BFF_TOKEN。
# SUWAYOMI_AUTH_MODE=basic_auth
# SUWAYOMI_ADMIN_BIND=127.0.0.1
# SUWAYOMI_ADMIN_PORT=4567

# Studio 和归档服务需加入同一个 Docker 网络。
# LN_VOLUME_ARCHIVE_URL=http://suwayomi-volume-cbz:8788
# DSH 可通过私有 JSON 配置 Suwayomi 和归档服务。
# LN_MANGA_CONNECTION_FILE=/path/to/suwayomi.json

# ----- Komga（Studio 可选，只读连接）-----
# 容器可达的 Komga 基地址；允许 reverse proxy 子路径，例如 http://komga:25600/bookshelf
# LN_KOMGA_URL=http://komga:25600
# WebUI 允许保存的 Komga 完整地址，可用逗号分隔。
# LN_KOMGA_ALLOWED_URLS=http://komga:25600
# DSH studio_read 工具可选设置。密钥放入容器可读的私有文件。
# LN_STUDIO_READ_URL=http://studio:8080
# LN_STUDIO_READ_TOKEN_FILE=/path/to/studio-read.token
# 推荐用 Komga API Key；也可改用完整的用户名/密码（不要同时配置两种认证）。
# LN_KOMGA_API_KEY=
# LN_KOMGA_USERNAME=
# LN_KOMGA_PASSWORD=
# 上游请求超时（毫秒，默认 8000，最大 30000）。
# LN_KOMGA_TIMEOUT_MS=8000
# 配置 Komga 凭据时请同时设置 LN_BFF_TOKEN，Studio 会用共享 BFF token 保护所有 API。

# ----- 构建期 -----
# 中国大陆建议保留镜像；其他地区可改为 https://pub.dev
PUB_HOSTED_URL=https://pub.flutter-io.cn
# 双栈主机若 Dart SDK（约 228MB）下载极慢，可强制走较快的 IP 族：
# 先分别测 curl --noproxy '*' -4 / -6 的下载速度，再按需设置为 -6 或 -4。
# 留空则由 curl 自行选择。
# DART_CURL_OPTS=-6
# 若构建容器内单连接仍很慢：宿主机下载 SDK 到 build-assets/ 目录后会自动
# 跳过容器内下载（见 docs/DEPLOY-NAS.md）。

# ----- 运行 DSH Agent 时按需提供（仅 --dump-config 验证不需要）-----
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
